    <id>org.pcsoft.intellij.plugin.asn1.language.test</id>
    <name>ASN.1 Language (test)</name>
    <vendor>KleinerHacker</vendor>

    <depends>com.intellij.modules.lang</depends>

    <xi:include href="/asn-1.language.xml" xpointer="xpointer(/idea-plugin/*)"/>
</idea-plugin>
