{
  parserClass="org.pcsoft.intellij.plugin.asn1.language.parser.AsnParser"
  parserUtilClass="org.pcsoft.intellij.plugin.asn1.language.parser.AsnParserUtil"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Asn"
  psiImplClassSuffix="Impl"
  psiPackage="org.pcsoft.intellij.plugin.asn1.language.parser.psi"
  psiImplPackage="org.pcsoft.intellij.plugin.asn1.language.parser.psi.impl"

  elementTypeHolderClass="org.pcsoft.intellij.plugin.asn1.language.parser.psi.AsnTypes"
  elementTypeClass="org.pcsoft.intellij.plugin.asn1.language.parser.psi.AsnElementType"
  tokenTypeClass="org.pcsoft.intellij.plugin.asn1.language.parser.psi.AsnTokenType"

  // The regular expressions only document the lexer (AsnLexer.flex); the lexer itself is not generated from here.
  tokens=[
    DEFINITIONS    = "DEFINITIONS"
    BEGIN          = "BEGIN"
    END            = "END"
    EXPLICIT       = "EXPLICIT"
    IMPLICIT       = "IMPLICIT"
    AUTOMATIC      = "AUTOMATIC"
    TAGS           = "TAGS"
    EXTENSIBILITY  = "EXTENSIBILITY"
    IMPLIED        = "IMPLIED"
    INSTRUCTIONS   = "INSTRUCTIONS"

    ASSIGN         = "::="
    LBRACE         = "{"
    RBRACE         = "}"
    LPAREN         = "("
    RPAREN         = ")"

    NUMBER          = "regexp:[0-9]+"
    UPPER_REFERENCE = "regexp:[A-Z](-?[A-Za-z0-9])*"
    IDENTIFIER      = "regexp:[a-z](-?[A-Za-z0-9])*"
    OTHER_SYMBOL    = "regexp:[!-/:-@\[-`{-~]"
    LINE_COMMENT    = "regexp:--.*"
    BLOCK_COMMENT   = "regexp:/\*.*\*/"
    BAD_CHARACTER   = "regexp:."
  ]
}

// ---------------------------------------------------------------------------------------------------------
// File level: a sequence of module definitions. Everything between modules that cannot start a module is
// skipped (with an error) up to the next module reference, so the parser never gives up on a file.
// ---------------------------------------------------------------------------------------------------------
private asnFile ::= item*

private item ::= moduleDefinition | junkToken

// A token that cannot start a module. A run of such tokens is reported as error up to the next module reference;
// a single one is reported by the annotator.
private junkToken ::= !UPPER_REFERENCE anyToken { recoverWhile=itemRecover }
private anyToken ::= bodyToken | END
private itemRecover ::= !UPPER_REFERENCE

// ---------------------------------------------------------------------------------------------------------
// Module definition (ITU-T X.680, clause 13). Pinned after the module identifier: whatever is missing behind
// it is reported as an error, the already typed part stays in the tree.
// ---------------------------------------------------------------------------------------------------------
moduleDefinition ::= moduleIdentifier DEFINITIONS headerDefault* ASSIGN BEGIN moduleBody END { pin=1 }

moduleIdentifier ::= UPPER_REFERENCE definitiveIdentifier? { recoverWhile=headerRecover }

// Order and uniqueness of the defaults (encoding reference, tag, extension) is checked by the annotator, the
// parser accepts them leniently in any order and any number.
private headerDefault ::= tagDefault | extensionDefault | encodingReferenceDefault

encodingReferenceDefault ::= UPPER_REFERENCE INSTRUCTIONS { pin=1 }

tagDefault ::= (EXPLICIT | IMPLICIT | AUTOMATIC) TAGS { pin=1 }

extensionDefault ::= EXTENSIBILITY IMPLIED { pin=1 }

// ---------------------------------------------------------------------------------------------------------
// Module body: a sequence of assignments (ITU-T X.680, clause 13.1). The notations on the right hand side are
// placeholders for now: they collect the tokens up to the next assignment, with braces kept pairwise together.
// A token that fits no assignment is collected as assignmentJunk up to the next assignment start.
// ---------------------------------------------------------------------------------------------------------
moduleBody ::= assignment*

assignment ::= typeAssignment | valueAssignment | assignmentJunk

// No recoverWhile on the two assignments: Grammar-Kit runs it even if the rule fails at its first token and would
// swallow the start of the next alternative. Leftover tokens are collected by assignmentJunk.
typeAssignment ::= UPPER_REFERENCE ASSIGN typeNotation { pin=2 }

// The type between the value name and "::=" ends at "::=" only: its first words may look like a type assignment
// start (e.g. "INTEGER ::="), so no assignment start check is made there.
valueAssignment ::= IDENTIFIER valueTypeItem+ ASSIGN valueNotation { pin=3 }

assignmentJunk ::= !END bodyToken { recoverWhile=assignmentRecover }

// The names make the pinned assignment report "type notation expected" if the right hand side is missing.
typeNotation ::= (!atAssignmentStart notationItem)+ { name="type notation" }

valueNotation ::= (!atAssignmentStart notationItem)+ { name="value notation" }

private valueTypeItem ::= bracedGroup | plainItem

private notationItem ::= bracedGroup | plainItem

private plainItem ::= !(ASSIGN | END | LBRACE | RBRACE) bodyToken

// Braces stay together. An unterminated group ends at "END" or at the next assignment start, whatever follows is
// not swallowed.
private bracedGroup ::= LBRACE groupItem* RBRACE { pin=1 }

private groupItem ::= bracedGroup | !(RBRACE | END | atAssignmentStart) bodyToken

private assignmentRecover ::= !(atAssignmentStart | END)

external atAssignmentStart ::= atAssignmentStart

external comma ::= comma

external semicolon ::= semicolon

private bodyToken ::= DEFINITIONS | BEGIN | EXPLICIT | IMPLICIT | AUTOMATIC | TAGS | EXTENSIBILITY | IMPLIED
                    | INSTRUCTIONS | ASSIGN | LBRACE | RBRACE | LPAREN | RPAREN | NUMBER | UPPER_REFERENCE
                    | IDENTIFIER | OTHER_SYMBOL | BAD_CHARACTER

private headerRecover ::= !(DEFINITIONS | ASSIGN | BEGIN | END)

// ---------------------------------------------------------------------------------------------------------
// Definitive object identifier of a module identifier: { iso(1) identified-organization(3) 6 }
// ---------------------------------------------------------------------------------------------------------
definitiveIdentifier ::= LBRACE definitiveObjIdComponent+ RBRACE { pin=1 recoverWhile=headerRecover }

definitiveObjIdComponent ::= definitiveNameAndNumberForm | nameForm | definitiveNumberForm

definitiveNameAndNumberForm ::= nameForm LPAREN definitiveNumberForm RPAREN { pin=2 }

definitiveNumberForm ::= NUMBER

// ---------------------------------------------------------------------------------------------------------
// Object identifier value (ITU-T X.680, clause 32) as a description of its own: reused wherever an object
// identifier value is needed, not tied to the module definition. A leading DefinedValue is syntactically
// identical to a NameForm and therefore parsed as such.
// ---------------------------------------------------------------------------------------------------------
objectIdentifierValue ::= LBRACE objIdComponents+ RBRACE { pin=1 recoverWhile=objectIdentifierValueRecover extraRoot=true }

private objectIdentifierValueRecover ::= !(RBRACE | DEFINITIONS | ASSIGN | BEGIN | END)

objIdComponents ::= nameAndNumberForm | nameForm | numberForm

nameAndNumberForm ::= nameForm LPAREN numberForm RPAREN { pin=2 }

numberForm ::= NUMBER | definedValue

definedValue ::= IDENTIFIER

// Shared by the definitive identifier and the object identifier value.
nameForm ::= IDENTIFIER
